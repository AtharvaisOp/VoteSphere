# VoteSphere Environment Variables
# Copy this file to .env and fill in your values

# SendGrid API Key for email delivery
SENDGRID_API_KEY=your-sendgrid-api-key-here

# Django Secret Key (change in production)
SECRET_KEY=your-secret-key-here

# Voter Identity Hashing Salt (change in production)
VOTER_SALT=your-random-salt-here

# Database (optional - defaults to SQLite)
# DATABASE_URL=postgresql://user:pass@localhost/votesphere
